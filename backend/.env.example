# SentinCash demo API configuration.
# Copy to .env and adjust if needed; every value below is optional.

PORT=5000

# SQLite is created automatically by the seeder. node:sqlite is built into Node 24,
# so no database server is required.
# DB_PATH=./data/app.db

# Login is implemented but NOT enforced on the read routes. The command-center login
# screen is deferred; set JWT_AUTH=true and mount middleware/authMiddleware.js on the
# read routers to require a token.
JWT_AUTH=false
JWT_SECRET=senticash-demo-secret

# The command center reads generated files rather than the database, so the API rebuilds
# them automatically after any write (a portal complaint, a helpline triage, a case triage
# edit, a model retrain). The rebuild is debounced, so a burst of writes costs one pass.
# Set AUTO_SYNC=false to go back to running `npm run sync` by hand.
AUTO_SYNC=true
# AUTO_SYNC_DEBOUNCE_MS=250

BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ID=
